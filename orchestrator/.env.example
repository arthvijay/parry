# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Every key is optional: without one, that part of the date falls back (templates,
# rules, a scripted date, the sample voice) so the whole flow still runs offline.

# ---- Speed date --------------------------------------------------------------------

# Claude: builds the date (matchmaker), judges chemistry live, writes the receipt.
ANTHROPIC_API_KEY=
# One model for all three; override per job below if you want.
CLAUDE_MODEL=claude-sonnet-5-5
MATCHMAKER_MODEL=
CHEMISTRY_MODEL=
DATE_GRADER_MODEL=
# Effort per job: low | medium | high.
MATCHMAKER_EFFORT=medium
CHEMISTRY_EFFORT=low
DATE_GRADER_EFFORT=medium
# Server-side refusal fallbacks (Claude API only); set 0 to turn off.
CLAUDE_FALLBACKS=1

# Gemini: the date's live replies. Either an API key...
GEMINI_API_KEY=
# ...or Vertex AI with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
DATE_MODEL=gemini-3.8-flash
DATE_THINKING_LEVEL=MINIMAL

# Deepgram: live speech recognition.
DEEPGRAM_API_KEY=

# Fish Audio: the date's voice.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_SAMPLE_RATE=24000
# Voice models: FISH_VOICE_<DIALECT>_<GENDER>, falling back to FISH_VOICE_<GENDER>.
FISH_VOICE_FEMALE=
FISH_VOICE_MALE=
FISH_VOICE_NONBINARY=
# e.g. FISH_VOICE_ES_AR_FEMALE=, FISH_VOICE_JA_JP_KANSAI_MALE=

# Webcam face tracking (needs `uv sync --group face`); 0 turns it off.
FACE_TRACKING=1
# FACE_MODEL_PATH=runs/models/face_landmarker.task

# Where dates, chemistry timelines and transcripts are kept.
DATE_DIR=runs/dates
CHEMISTRY_DIR=runs/chemistry
RUN_DIR=runs/transcripts

# ---- Legacy café (/v1/speech, /v1/scenarios) -----------------------------------------

ELEVENLABS_API_KEY=
OPENAI_API_KEY=
AGENT_ID_MARIA=
AGENT_ID_LUIS=
# Per-turn goal ticking (GET /v1/runs/{run_id}/goals); falls back to TUTOR_MODEL when empty.
# Must accept a reasoning parameter (a gpt-5.x model): the director runs at effort "none".
DIRECTOR_MODEL=
# End-of-run grading (POST /v1/grade); falls back to SCENARIO_MODEL when empty.
TUTOR_MODEL=
# HTTP scenario generation model (Responses structured outputs)
SCENARIO_MODEL=
SCENARIO_DIR=runs/scenarios
# Optional override; built-in ElevenLabs adapter is selected when credentials exist.
SPEECH_ADAPTER=
# Optional alternate NPC: npc_id=luis_beginner
AGENT_ID_LUIS_BEGINNER=
# Uploaded speech is transcribed before using the text-to-agent flow.
ELEVENLABS_STT_MODEL=scribe_v2
