# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Every key is optional: without one, that part of the date falls back (templates,
# rules, a scripted date, the sample voice) so the whole flow still runs offline.

# ---- Speed date --------------------------------------------------------------------

# Claude: builds the date (matchmaker), judges chemistry live (and writes the translator
# card), writes the receipt and the learning report (the grader's model and effort).
ANTHROPIC_API_KEY=
# One model for all three; override per job below if you want.
CLAUDE_MODEL=claude-sonnet-5-5
MATCHMAKER_MODEL=
CHEMISTRY_MODEL=
DATE_GRADER_MODEL=
# Effort per job: low | medium | high.
MATCHMAKER_EFFORT=medium
CHEMISTRY_EFFORT=low
DATE_GRADER_EFFORT=medium
# Server-side refusal fallbacks (Claude API only); set 0 to turn off.
CLAUDE_FALLBACKS=1

# Who speaks as the date: claude (default) or gemini (Gemini Flash in front of Claude).
DATE_BRAIN=claude
# The Claude model for the date's replies (default: CLAUDE_MODEL).
DATE_CLAUDE_MODEL=

# Gemini: the date's replies when DATE_BRAIN=gemini, and the report's pronunciation notes
# (it listens to the learner's clips). Either an API key...
GEMINI_API_KEY=
# ...or Vertex AI with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
DATE_MODEL=gemini-3.8-flash
DATE_THINKING_LEVEL=LOW

# Nemotron ASR (NVIDIA): live speech recognition over Riva gRPC.
# Hosted: an API key from build.nvidia.com. The default function id is NVIDIA's hosted
# Nemotron ASR Streaming (English); for Spanish, set the function id of the multilingual
# Nemotron 3.5 deployment, or point the server at a self-hosted Speech NIM
# (NIM_TAGS_SELECTOR="name=nemotron-asr-streaming,type=multi", e.g. localhost:50051).
NVIDIA_API_KEY=
NEMOTRON_ASR_SERVER=grpc.nvcf.nvidia.com:443
NEMOTRON_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
# TLS: on for :443, off for a local NIM; set 0 or 1 to force.
NEMOTRON_ASR_SSL=
# Forces one locale for every dialect (e.g. es-US, es-ES, auto); empty = per dialect.
NEMOTRON_ASR_LANGUAGE=
# Hosted Nemotron is English only. Spanish and other languages use NVIDIA's hosted
# multilingual ASR (Parakeet 1.1B RNNT Multilingual) by default; set another function id
# here, or point NEMOTRON_ASR_SERVER at a self-hosted multilingual Nemotron NIM.
NVIDIA_ASR_MULTILINGUAL_FUNCTION_ID=

# ElevenLabs: the date's voice (streaming text-to-speech). The same key also serves the
# legacy café agents below.
ELEVENLABS_API_KEY=
# Flash v2.5 is ElevenLabs' lowest-latency multilingual model.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Voices: ELEVENLABS_VOICE_<DIALECT>_<GENDER>, falling back to ELEVENLABS_VOICE_<GENDER>,
# then a premade voice. For the Argentine demo, add porteño voices from the Voice Library
# to My Voices and put their ids here.
ELEVENLABS_VOICE_ES_AR_FEMALE=
ELEVENLABS_VOICE_ES_AR_MALE=
# Southern American English (the English demo). Unset = premade Jessica / Will.
# Accented Voice Library voices need a paid plan, e.g. DCJ53Jyl6Yue4JEOi4o9 (Texan, late 20s).
ELEVENLABS_VOICE_EN_US_SOUTH_FEMALE=
ELEVENLABS_VOICE_EN_US_SOUTH_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_NONBINARY=
# e.g. ELEVENLABS_VOICE_ES_MX_FEMALE=, ELEVENLABS_VOICE_JA_JP_KANSAI_MALE=

# Webcam face tracking (needs `uv sync --group face`); 0 turns it off.
FACE_TRACKING=1
# FACE_MODEL_PATH=runs/models/face_landmarker.task

# Where dates, chemistry timelines, transcripts, the learner's voice clips, the
# learning reports and graded verdicts (for sharing) are kept. Audio and reports default to folders next to RUN_DIR.
DATE_DIR=runs/dates
CHEMISTRY_DIR=runs/chemistry
RUN_DIR=runs/transcripts
# RUN_AUDIO_DIR=runs/audio
# REPORT_DIR=runs/reports
# VERDICT_DIR=runs/verdicts

# ---- Legacy café (/v1/speech, /v1/scenarios) -----------------------------------------
# Uses ELEVENLABS_API_KEY from the speed-date section above.
OPENAI_API_KEY=
AGENT_ID_MARIA=
AGENT_ID_LUIS=
# Per-turn goal ticking (GET /v1/runs/{run_id}/goals); falls back to TUTOR_MODEL when empty.
# Must accept a reasoning parameter (a gpt-5.x model): the director runs at effort "none".
DIRECTOR_MODEL=
# End-of-run grading (POST /v1/grade); falls back to SCENARIO_MODEL when empty.
TUTOR_MODEL=
# HTTP scenario generation model (Responses structured outputs)
SCENARIO_MODEL=
SCENARIO_DIR=runs/scenarios
# Optional override; built-in ElevenLabs adapter is selected when credentials exist.
SPEECH_ADAPTER=
# Optional alternate NPC: npc_id=luis_beginner
AGENT_ID_LUIS_BEGINNER=
# Uploaded speech is transcribed before using the text-to-agent flow.
ELEVENLABS_STT_MODEL=scribe_v2
